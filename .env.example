# Copy to .env and fill in. `docker compose` reads .env automatically.
# The only value you must supply is the Anthropic API key.

# --- Required -----------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Model ---------------------------------------------------------------------
# Needs two things, not one: the computer_20251124 tool AND adaptive thinking,
# which the loop always sends. claude-opus-5, claude-sonnet-5, claude-opus-4-8,
# claude-opus-4-7, claude-opus-4-6, claude-sonnet-4-6.
#
# claude-opus-4-5 supports the tool but is extended-thinking-only and rejects
# {"type": "adaptive"} with a 400. Running it here means also switching the
# request to {"type": "enabled", "budget_tokens": N}.
DESKWORK_MODEL=claude-opus-5

# low | medium | high | xhigh | max. Higher spends more tokens per step.
DESKWORK_EFFORT=high

# Hard ceiling on agent turns, so a confused run cannot bill indefinitely.
DESKWORK_MAX_STEPS=40

# Screenshots are the bulk of token spend. Only the N most recent are kept in
# context; older ones are pruned in place.
DESKWORK_MAX_IMAGES=6

# --- Display -------------------------------------------------------------------
# Must match the display_width_px / display_height_px sent to the API, and the
# Xvfb geometry. See SPEC.md section 6.2 — keeping these equal is deliberate.
DESKWORK_DISPLAY_WIDTH=1024
DESKWORK_DISPLAY_HEIGHT=768
DISPLAY=:99

# --- Services ------------------------------------------------------------------
DESKWORK_PORTAL_URL=http://portal:8000
DATABASE_URL=postgresql://deskwork:deskwork@db:5432/deskwork

# --- Retrieval -----------------------------------------------------------------
DESKWORK_EMBED_MODEL=BAAI/bge-small-en-v1.5
DESKWORK_TOP_K=4
