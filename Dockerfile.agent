# The agent's desktop: an X display, a browser, and the agent that drives them.
#
# Structured after Anthropic's own computer-use reference implementation so the shape is
# familiar to anyone who has read it. The reference this repo replaces shipped a Dockerfile
# that installed Homebrew into a Debian image and then `brew install cliclick` — a
# macOS-only binary. That container has never built.
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11vnc fluxbox xdotool scrot xauth x11-utils \
      firefox-esr \
      novnc websockify \
      fonts-dejavu-core ca-certificates \
      libgomp1 \
    && rm -rf /var/lib/apt/lists/*
# libgomp1 is ONNX Runtime's OpenMP dependency. fastembed loads onnxruntime, and on a
# -slim base the wheel imports fine but fails at load with "libgomp.so.1: cannot open
# shared object file" — which kills the image build at the embedding warm-up below.

WORKDIR /app

# Install from the lockfile so an image built in six months matches the one that was
# tested. `pip install .` re-resolves unbounded dependency ranges on every build, which
# is how a repo that worked at publication quietly stops working later.
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN pip install --no-cache-dir uv && uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:$PATH"

# Bake the embedding weights into the image. Downloading ~130MB on first run would
# otherwise happen in the middle of the demo, looking like a hang.
RUN python -c "from deskwork.embeddings import warm; warm('BAAI/bge-small-en-v1.5')"

COPY corpus ./corpus
COPY docker/agent-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# 6080 serves noVNC so you can watch the run in a browser. That view is most of the value
# of the demo: an agent working is much more convincing than a log of it having worked.
EXPOSE 6080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sleep", "infinity"]
